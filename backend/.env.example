PORT=5000
MONGODB_URI=<chuoi-ket-noi-mongodb>

MQTT_BROKER_URL=mqtts://<host>.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=<username>
MQTT_PASSWORD=<password>

MQTT_TOPIC_TELEMETRY=hcmute/iot/climate/telemetry
MQTT_TOPIC_STATUS=hcmute/iot/climate/status
MQTT_TOPIC_CONTROL=hcmute/iot/climate/control

# Domain của frontend được phép gọi API/Socket (cách nhau bằng dấu phẩy).
# Bỏ trống hoặc "*" = cho phép mọi nguồn.
# CORS_ORIGIN=https://iot.example.com
